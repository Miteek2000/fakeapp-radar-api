UPLOAD_DIR=uploads
MAX_UPLOAD_MB=100
REDIS_PASSWORD=cambia_esta_clave
# Conexión a la base del repo fakeapp-radar-db (el host es el nombre de su contenedor).
# Si la contraseña tiene símbolos (@ : / % # ...), van codificados como %40 %3A %2F %25 %23.
DATABASE_URL=postgresql+psycopg://fakeapp:CLAVE_DE_LA_BASE@fakeapp-db:5432/fakeapp_radar
# Clave AES-256 (32 bytes en base64). Genera una con:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=genera_una_clave_nueva
# Retención: días que se conservan los análisis y horas que se conservan APK sueltos.
RETENTION_DAYS=30
ORPHAN_UPLOAD_HOURS=24
