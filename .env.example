UPLOAD_DIR=uploads
MAX_UPLOAD_MB=100
REDIS_PASSWORD=cambia_esta_clave
# Conexión a la base del repo fakeapp-radar-db (el host es el nombre de su contenedor).
# Si la contraseña tiene símbolos (@ : / % # ...), van codificados como %40 %3A %2F %25 %23.
DATABASE_URL=postgresql+psycopg://fakeapp:CLAVE_DE_LA_BASE@fakeapp-db:5432/fakeapp_radar
# Clave AES-256 (32 bytes en base64). Genera una con:
#   python -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=genera_una_clave_nueva
# Retención: días que se conservan los análisis y horas que se conservan APK sueltos.
RETENTION_DAYS=30
ORPHAN_UPLOAD_HOURS=24
# VirusTotal (clave gratuita: virustotal.com > tu perfil > API key). Solo la usa el servicio vt-worker.
# Límite gratuito: 4 consultas por minuto y 500 por día. NO la subas a GitHub.
VT_API_KEY=
VT_CACHE_HOURS=24
# Clave para firmar los tokens de login (RSA, en base64). Genera una con:
#   python -m app.auth.keygen
# Solo la usa la API. NO la subas a GitHub. Si la pierdes, solo se cierran las sesiones abiertas.
JWT_PRIVATE_KEY_B64=
# Pon true cuando sirvas la API por HTTPS (la cookie de sesión solo viajará cifrada).
COOKIE_SECURE=false
# true = se puede analizar sin cuenta. false = hace falta iniciar sesión.
ALLOW_ANONYMOUS=true
