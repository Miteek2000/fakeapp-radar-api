# Proxy HTTPS público de APK Radar. {$SITE_ADDRESS} viene del .env (ej. 54-221-43-212.sslip.io).
# Caddy pide solo el certificado a Let's Encrypt y lo renueva. Solo TLS 1.3.
{
	admin off
}

{$SITE_ADDRESS} {
	tls {
		protocols tls1.3
	}

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}

	reverse_proxy web:3000
}
